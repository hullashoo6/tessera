---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import HeroMosaic from '../components/HeroMosaic.astro'
import Faq from '../components/Faq.astro'
import { faqs, homeFaqs } from '../data/faq'
import { formatPrice, freeFeatures, platforms, pricing, product, proFeatures } from '../data/site'
import { releaseFor } from '../data/releases'
import shotMap from '../assets/screens/app-map.png'
import shotSmart from '../assets/screens/app-smart.png'
import shotCleanup from '../assets/screens/app-cleanup.png'

const title = 'Tessera: disk space analyser for Windows and Mac'
const description =
  'See what fills your computer, learn what is safe to remove, and clear it away with Undo. For Windows and Mac. Your scans never leave your computer.'

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: product.name,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Windows 11, macOS 12 or later',
      description: product.description,
      ...(pricing.onSale && {
        offers: { '@type': 'Offer', price: String(pricing.pro), priceCurrency: pricing.currency },
      }),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
}

const trust = [
  ['Private by design', 'Scans happen on your computer. There is no account, no upload and no tracking.'],
  ['Careful by default', 'System folders are off limits, every item is checked again just before it is moved, and nothing is deleted permanently unless you choose to.'],
  ['Pay once', `Pro is a single payment of ${formatPrice()} for one computer, with a full refund within 14 days if it is not for you.`],
] as const
---

<Base title={title} description={description} schema={schema}>
  <section class="hero" aria-labelledby="hero-title">
    <HeroMosaic />
    <div class="wrap hero-copy">
      <h1 id="hero-title">{product.tagline}</h1>
      <p class="lede">Tessera shows what fills your computer, tells you what is safe to remove, and clears it away, with Undo if you change your mind.</p>
      <div class="actions">
        <a class="btn btn-primary" href="#download">Download free</a>
        {pricing.onSale && <a class="btn btn-quiet" href="#pricing">Buy Pro for {formatPrice()}</a>}
      </div>
      <p class="fine">For Windows 11 and macOS. Your scans never leave your computer.</p>
    </div>
  </section>

  <section id="product" class="showcase" aria-labelledby="product-title">
    <div class="wrap">
      <div class="section-head centred">
        <h2 id="product-title">See where your space went.</h2>
        <p class="lede">Every folder becomes a tile, sized by the space it takes. Games, videos and old backups stand out at once, and any tile opens to show what is inside.</p>
      </div>
      <figure class="window">
        <Image src={shotMap} alt="Tessera's storage map of a demonstration computer: Games take 101 GB, Videos 43 GB and Backups 40 GB, with Apps, Downloads, Photos and Music beside them." widths={[800, 1200, 1600, 2000]} sizes="(max-width: 1200px) 100vw, 1160px" loading="eager" />
      </figure>
      <p class="caption muted">Tessera on Windows 11, shown with sample files. The Mac version looks and works the same.</p>
    </div>
  </section>

  <section id="how" aria-label="How Tessera helps">
    <div class="wrap rows">
      <div class="row">
        <div class="row-copy">
          <h2>Know what is safe to remove.</h2>
          <p class="lede">Smart Scan finds the things that quietly fill a computer, and says why each one was found and how safe it is to remove.</p>
          <ul class="points">
            <li>Browser caches and temporary files that apps recreate</li>
            <li>Old installers, phone backups and screen recordings</li>
            <li>Exact duplicates, compared by their contents</li>
          </ul>
        </div>
        <figure class="window">
          <Image src={shotSmart} alt="Smart Scan suggesting browser caches, crash reports and old installers, each with why it was found and how safe it is to remove." widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 680px" />
        </figure>
      </div>
      <div class="row flip">
        <div class="row-copy">
          <h2>Clear it away, and stay in control.</h2>
          <p class="lede">Add what you no longer need to one list, check it, and move it all to the Recycle Bin or Trash in one step.</p>
          <ul class="points">
            <li>Undo puts everything back in one click</li>
            <li>Nothing is deleted permanently unless you choose to</li>
            <li>Plain answers when a file is open in another app</li>
          </ul>
        </div>
        <figure class="window">
          <Image src={shotCleanup} alt="The cleanup list with browser caches, crash reports and a duplicate video, all selected, and a button to move them to the Recycle Bin." widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 680px" />
        </figure>
      </div>
    </div>
  </section>

  <section id="trust" class="trust" aria-labelledby="trust-title">
    <div class="wrap">
      <h2 id="trust-title">Built to be trusted with your files.</h2>
      <div class="trust-grid">
        {trust.map(([t, d]) => (
          <div><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section id="pricing" aria-labelledby="pricing-title">
    <div class="wrap">
      <div class="section-head centred">
        <h2 id="pricing-title">Free to explore. Pro to clean up.</h2>
        <p class="lede">Scanning is free, with no limits. Pro is one payment, with no subscription.</p>
      </div>
      <div class="plans">
        <article class="plan">
          <h3>Free</h3>
          <p class="price num">$0</p>
          <p class="muted">Yours to keep, with no time limit.</p>
          <ul>{freeFeatures.map((f) => <li>{f.name}</li>)}</ul>
          <a class="btn btn-quiet" href="#download">Download free</a>
        </article>
        <article class="plan pro">
          <h3>Pro</h3>
          <p class="price num">{formatPrice()}{!pricing.onSale && <span class="tag">Not yet on sale</span>}</p>
          <p class="muted">One payment, tax included. For one computer, with no expiry.</p>
          <ul>{proFeatures.map((f) => <li>{f.name}</li>)}</ul>
          {pricing.onSale ? (
            <a class="btn btn-primary" href={pricing.checkoutUrl} rel="noopener">Buy Tessera Pro</a>
          ) : (
            <span class="btn btn-primary" aria-disabled="true">Available at launch</span>
          )}
        </article>
      </div>
      <p class="plans-note muted">Secure checkout by Dodo Payments. Your licence key arrives by email; enter it in Tessera under Settings. It works on Windows and Mac, and you can ask for a full refund within 14 days.</p>
    </div>
  </section>

  <section id="download" aria-labelledby="download-title">
    <div class="wrap">
      <div class="section-head centred">
        <h2 id="download-title">Get Tessera.</h2>
        <p class="lede">Free to download and use, with no account and no time limit.</p>
      </div>
      <ul class="platforms">
        {platforms.map((p) => {
          const r = releaseFor(p.id)
          return (
            <li data-platform={p.id}>
              <div class="platform">
                <h3>{p.label}</h3>
                <p class="muted">{r ? r.minimumOs : p.requirement}</p>
              </div>
              {r ? (
                <div class="release">
                  <a class="btn btn-primary get" href={r.url}>Download for {p.label}</a>
                  <p class="muted num">Version {r.version} · {(r.bytes / 1048576).toFixed(1)} MB · <a href={r.notesUrl}>Release notes</a></p>
                  <details class="sum">
                    <summary>Verify the download (SHA-256)</summary>
                    <code class="num">{r.sha256}</code>
                  </details>
                </div>
              ) : (
                <span class="state">{p.state}</span>
              )}
            </li>
          )
        })}
      </ul>
      <p class="install-note muted">Windows may show a “Windows protected your PC” notice the first time you open Tessera. Choose More info, then Run anyway. On a Mac, the installer window shows the one-time step to open it.</p>
    </div>
  </section>

  <section id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-wrap">
      <h2 id="faq-title">Questions, answered.</h2>
      <div>
        <Faq items={homeFaqs} />
        <p class="more"><a href="/help">More answers in Help</a></p>
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap">
      <h2 id="closing-title">Know exactly where your space went.</h2>
      <a class="btn btn-primary" href="#download">Download free</a>
    </div>
  </section>
</Base>

<script>
  // The visitor's own system comes first with the main button; the other
  // download stays right below it, one click away.
  const ua = navigator.userAgent
  const id = /Windows/.test(ua) ? 'windows-x64' : /Mac/.test(ua) ? 'mac-universal' : null
  const mine = id ? document.querySelector(`[data-platform="${id}"]`) : null
  if (mine) {
    mine.parentElement?.prepend(mine)
    document.querySelectorAll('[data-platform]').forEach((li) => {
      if (li !== mine) li.querySelector('.get')?.classList.replace('btn-primary', 'btn-quiet')
    })
  }
</script>

<style>
  .hero { position: relative; min-height: min(88vh, 860px); display: grid; align-items: center; overflow: hidden; padding: 140px 0 120px; border: 0; }
  .hero::after { content: ''; position: absolute; inset: auto 0 0 0; height: 200px; background: linear-gradient(180deg, transparent, var(--forest)); pointer-events: none; }
  .hero + section { border-top: 0; }
  .hero-copy { position: relative; z-index: 1; text-align: center; display: grid; justify-items: center; gap: 28px; }
  .hero h1 { max-width: 13ch; text-shadow: 0 2px 30px rgba(10, 8, 4, 0.45); }
  .hero .lede { color: var(--cream); max-width: 46ch; text-shadow: 0 1px 14px rgba(10, 8, 4, 0.6); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 4px; }
  .fine { font-size: 14px; color: var(--mist); }

  .centred { margin-inline: auto; text-align: center; justify-items: center; }
  .showcase { padding-top: 24px; }
  .window { margin: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line-strong); box-shadow: 0 50px 110px -40px rgba(0, 0, 0, 0.75); background: var(--night); }
  .window img { display: block; width: 100%; height: auto; }
  .caption { margin-top: 18px; font-size: 14px; text-align: center; }

  .rows { display: grid; gap: clamp(96px, 12vw, 160px); }
  .row { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(40px, 6vw, 88px); align-items: center; }
  .row.flip { grid-template-columns: 7fr 5fr; }
  .row.flip .row-copy { order: 2; }
  .row-copy { display: grid; gap: 22px; align-content: center; }
  .row-copy h2 { font-size: clamp(30px, 3.4vw, 44px); }
  .row-copy .lede { font-size: 18px; }
  .points { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 12px; border-top: 1px solid var(--line); padding-top: 22px; }
  .points li, .plan li { position: relative; padding-left: 28px; color: var(--mist); }
  .points li::before, .plan li::before {
    content: ''; position: absolute; left: 2px; top: 0.5em; width: 12px; height: 6px;
    border-left: 1.5px solid var(--amber); border-bottom: 1.5px solid var(--amber); transform: rotate(-45deg);
  }

  .trust { background: linear-gradient(180deg, var(--forest), var(--forest-2)); }
  .trust h2 { max-width: 16ch; margin-bottom: 56px; }
  .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
  .trust-grid div { display: grid; gap: 12px; align-content: start; padding-top: 22px; border-top: 1px solid var(--line-strong); }
  .trust-grid p { color: var(--mist); }

  .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 900px; margin-inline: auto; }
  .plan { display: grid; gap: 12px; grid-template-rows: auto auto auto 1fr auto; padding: 36px; border-radius: var(--radius); border: 1px solid var(--line); background: rgba(243, 236, 223, 0.03); }
  .plan.pro { border-color: rgba(233, 174, 99, 0.38); background: rgba(233, 174, 99, 0.05); }
  .price { font-family: var(--serif); font-variation-settings: 'SOFT' 100; font-size: 48px; line-height: 1.1; display: flex; align-items: center; gap: 12px; }
  .plan ul { list-style: none; margin: 10px 0 22px; padding: 0; display: grid; gap: 12px; align-content: start; }
  .plan .btn { justify-self: start; }
  .plans-note { max-width: 64ch; margin: 28px auto 0; text-align: center; font-size: 15px; }

  .platforms { list-style: none; margin: 0 auto; padding: 0; max-width: 900px; border-top: 1px solid var(--line); }
  .platforms li { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 30px 0; border-bottom: 1px solid var(--line); }
  .platform { display: grid; gap: 6px; }
  .platform h3 { display: flex; align-items: center; gap: 12px; }
  .state { color: var(--sage); font-size: 15px; padding: 6px 14px; border: 1px solid var(--line-strong); border-radius: 999px; white-space: nowrap; }
  .release { display: grid; gap: 8px; justify-items: end; text-align: right; }
  .release p { font-size: 14px; }
  .sum summary { cursor: pointer; font-size: 13px; color: var(--sage); }
  .sum code { display: block; margin-top: 6px; font-size: 12px; color: var(--sage); word-break: break-all; max-width: 40ch; }
  .install-note { max-width: 70ch; margin: 28px auto 0; text-align: center; font-size: 14px; }

  .faq-wrap { display: grid; grid-template-columns: 4fr 7fr; gap: 56px; align-items: start; }
  .more { margin-top: 22px; }
  .more a { color: var(--amber-soft); }

  .closing { text-align: center; }
  .closing .wrap { display: grid; justify-items: center; gap: 30px; }

  @media (max-width: 900px) {
    .row, .trust-grid, .plans, .faq-wrap { grid-template-columns: 1fr; }
    .row.flip .row-copy { order: 0; }
    .platforms li { flex-direction: column; align-items: flex-start; }
    .release { justify-items: start; text-align: left; }
  }
</style>
