---
import '@fontsource-variable/fraunces/soft.css'
import '@fontsource-variable/instrument-sans'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { product } from '../data/site'

interface Props {
  title: string
  description: string
  /** JSON-LD object for this page, if any. */
  schema?: Record<string, unknown>
  noindex?: boolean
  /** Open Graph type: "article" for blog articles. */
  type?: 'website' | 'article'
}

const { title, description, schema, noindex = false, type = 'website' } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL('/og.png', Astro.site).href
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#142019" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <link rel="alternate" type="application/rss+xml" title="The Tessera blog" href="/blog/rss.xml" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
