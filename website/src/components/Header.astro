---
import Mark from './Mark.astro'
const links = [
  ['How it works', '/#product'],
  ['Pricing', '/#pricing'],
  ['Download', '/#download'],
  ['Blog', '/blog'],
  ['Help', '/help'],
] as const
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Tessera home">
      <Mark size={26} />
      <span>Tessera</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-primary cta" href="/#download">Download free</a>
  </div>
</header>

<style>
  .site-header { position: absolute; inset: 0 0 auto 0; z-index: 10; }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 76px; }
  .brand {
    display: inline-flex; align-items: center; gap: 10px; text-decoration: none;
    font-family: var(--serif); font-variation-settings: 'SOFT' 100, 'opsz' 30; font-size: 22px; font-weight: 500;
  }
  nav ul { display: flex; gap: 30px; margin: 0; padding: 0; list-style: none; }
  nav a { color: var(--mist); text-decoration: none; font-size: 15px; }
  nav a:hover { color: var(--cream); }
  .cta { justify-self: end; min-height: 38px; padding: 0 16px; font-size: 14px; }
  @media (max-width: 860px) {
    .bar { grid-template-columns: 1fr auto; }
    nav { display: none; }
  }
</style>
