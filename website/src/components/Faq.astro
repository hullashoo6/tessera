---
import { faqs } from '../data/faq'

interface Props {
  /** Which questions to show; all of them by default. */
  items?: [string, string][]
}
const { items = faqs } = Astro.props
---

<div class="faq">
  {items.map(([q, a]) => (
    <details>
      <summary>{q}</summary>
      <p>{a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); max-width: 820px; }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; padding: 22px 40px 22px 0; position: relative;
    font-family: var(--serif); font-variation-settings: 'SOFT' 100, 'opsz' 24; font-size: 21px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 18px; font: 300 26px/1 var(--sans); color: var(--sage); }
  details[open] summary::after { content: '–'; }
  details p { padding: 0 0 24px; color: var(--mist); max-width: 66ch; }
</style>
