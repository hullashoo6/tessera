---
// Decorative hero art: a squarified treemap of tiles with warm light
// falling through its centre. Generated at build time; no runtime script.
import { rng, squarify, type Rect } from '../lib/squarify'

const W = 1600
const H = 1000
const rand = rng(1931)

interface TileArt extends Rect {
  dark: number
  warm: number
}

const tiles: TileArt[] = []
const inset = (r: Rect, d: number): Rect => ({ x: r.x + d, y: r.y + d, w: Math.max(0, r.w - 2 * d), h: Math.max(0, r.h - 2 * d) })
const weights = (n: number) => Array.from({ length: n }, () => 0.15 + rand()).sort((a, b) => b - a)
const push = (r: Rect) => {
  if (r.w > 4 && r.h > 4) tiles.push({ ...r, dark: rand(), warm: rand() })
}

for (const big of squarify([30, 20, 15, 11, 8, 6, 4, 3, 2], { x: -60, y: -60, w: W + 120, h: H + 120 })) {
  for (const mid of squarify(weights(2 + Math.floor(rand() * 6)), inset(big, 4))) {
    if (mid.w * mid.h > 36000 && rand() > 0.35) {
      for (const small of squarify(weights(2 + Math.floor(rand() * 5)), inset(mid, 3))) push(inset(small, 3))
    } else {
      push(inset(mid, 3))
    }
  }
}

const r1 = (n: number) => Math.round(n * 10) / 10
---

<svg class="mosaic" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="m-bg" cx="52%" cy="46%" r="72%">
      <stop offset="0" stop-color="#22362a"></stop>
      <stop offset="1" stop-color="#0b120e"></stop>
    </radialGradient>
    <radialGradient id="m-light" cx="55%" cy="40%" r="40%">
      <stop offset="0" stop-color="#fff" stop-opacity="1"></stop>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
    <mask id="m-lit">
      <rect width={W} height={H} fill="url(#m-light)"></rect>
    </mask>
    <linearGradient id="m-beam" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f3cd96" stop-opacity="0.7"></stop>
      <stop offset="1" stop-color="#f3cd96" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id="m-vignette" cx="50%" cy="50%" r="75%">
      <stop offset="0.55" stop-color="#0b120e" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#0b120e" stop-opacity="0.9"></stop>
    </radialGradient>
    <radialGradient id="m-scrim" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#120d07" stop-opacity="0.62"></stop>
      <stop offset="1" stop-color="#120d07" stop-opacity="0"></stop>
    </radialGradient>
    <filter id="m-soft"><feGaussianBlur stdDeviation="0.8"></feGaussianBlur></filter>
    <filter id="m-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="70"></feGaussianBlur></filter>
    <filter id="m-haze" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="16"></feGaussianBlur></filter>
    <filter id="m-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
  </defs>

  <rect width={W} height={H} fill="url(#m-bg)"></rect>

  <g filter="url(#m-soft)">
    {tiles.map((t) => (
      <rect x={r1(t.x)} y={r1(t.y)} width={r1(t.w)} height={r1(t.h)} rx="5" fill={`hsl(146 15% ${(12 + t.dark * 9).toFixed(1)}%)`}></rect>
    ))}
  </g>

  <ellipse cx="880" cy="400" rx="460" ry="320" fill="#e9ae63" opacity="0.3" filter="url(#m-glow)"></ellipse>

  <g mask="url(#m-lit)">
    {tiles.map((t) => (
      <rect
        x={r1(t.x)} y={r1(t.y)} width={r1(t.w)} height={r1(t.h)} rx="5"
        fill={`hsl(${(30 + t.warm * 12).toFixed(0)} 68% ${(40 + t.warm * 22).toFixed(1)}%)`}
        opacity={(0.35 + t.warm * 0.5).toFixed(2)}
      ></rect>
    ))}
  </g>

  <g class="beams" filter="url(#m-haze)" opacity="0.32">
    <polygon points="700,-80 820,-80 1180,1080 960,1080" fill="url(#m-beam)"></polygon>
    <polygon points="900,-80 960,-80 1320,1080 1210,1080" fill="url(#m-beam)"></polygon>
    <polygon points="560,-80 610,-80 830,1080 740,1080" fill="url(#m-beam)"></polygon>
  </g>

  <ellipse cx="800" cy="560" rx="560" ry="240" fill="url(#m-scrim)"></ellipse>
  <rect width={W} height={H} fill="url(#m-vignette)"></rect>
  <rect class="grain" width={W} height={H} filter="url(#m-grain)" opacity="0.08"></rect>
</svg>

<style>
  .mosaic { position: absolute; inset: 0; width: 100%; height: 100%; }
  .beams { mix-blend-mode: screen; }
  .grain { mix-blend-mode: overlay; }
</style>
