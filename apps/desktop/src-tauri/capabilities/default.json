{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: Tessera's own commands and listening to scan events. No file-system, shell, dialog or opener access is granted to the interface.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-list-volumes",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-scan-status",
    "allow-node-details",
    "allow-children",
    "allow-treemap",
    "allow-largest-files",
    "allow-search",
    "allow-smart-scan",
    "allow-find-duplicates",
    "allow-cancel-duplicates",
    "allow-recently-moved",
    "allow-put-back-item",
    "allow-clear-moved-history",
    "allow-list-apps",
    "allow-uninstall-app",
    "allow-move-leftovers",
    "allow-export-report",
    "allow-free-up-cloud",
    "allow-check-update",
    "allow-storage-history",
    "allow-clear-storage-history",
    "allow-open-download-page",
    "allow-review-cleanup",
    "allow-confirm-cleanup",
    "allow-stop-cleanup",
    "allow-undo-cleanup",
    "allow-cleanup-except-in-use",
    "allow-open-recycle-bin",
    "allow-reveal-in-scan",
    "allow-license-status",
    "allow-refresh-license",
    "allow-activate-license",
    "allow-deactivate-license",
    "allow-reveal-item",
    "allow-open-item",
    "allow-log-error",
    "allow-show-log-file",
    "allow-background-settings",
    "allow-set-background-settings",
    "allow-print-report",
    "allow-set-scan-settings"
  ]
}
