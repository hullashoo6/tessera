{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: Tessera's own commands and listening to scan events. No file-system, shell, dialog or opener access is granted to the interface.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-list-volumes",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-scan-status",
    "allow-node-details",
    "allow-children",
    "allow-treemap",
    "allow-largest-files",
    "allow-search",
    "allow-review-cleanup",
    "allow-confirm-cleanup",
    "allow-license-status",
    "allow-refresh-license",
    "allow-activate-license",
    "allow-deactivate-license",
    "allow-reveal-item",
    "allow-open-item"
  ]
}
